+package nodomain.freeyourgadget.gadgetbridge.devices.oraimo;
+
+import androidx.annotation.DrawableRes;
+
+import java.util.regex.Pattern;
+
+import nodomain.freeyourgadget.gadgetbridge.R;
+import nodomain.freeyourgadget.gadgetbridge.devices.moyoung.AbstractMoyoungDeviceCoordinator;
+
+/**
+ * Coordinator for the Oraimo Watch 6 Lite (hardware models OSW-809 / OSW-809_PK;
+ * regional faces OSW-809_frf "Watch 6 HAYATO", OSW-809_frm "Watch 6 MOCO").
+ *
+ * <p>Device-specific assumptions (evidence-backed, see OSW-809 dossier):
+ * <ul>
+ *   <li>Protocol family: MoYoung/CRREPA ("Da Fit"), generation <b>V2</b> —
+ *       on-device 0x2A29 manufacturer name read "MOYOUNG-V2" (nRF Connect,
+ *       2026-10-05). The inherited {@code MoyoungDeviceSupport} engine is used
+ *       unmodified; this class adds no protocol logic of its own.</li>
+ *   <li>Discovery: inherits the family scan filter (service 0xFEEA in
+ *       advertisements). A raw advertisement capture confirming FEEA-in-adv is
+ *       still pending (EXP-017); if discovery fails, that capture decides
+ *       whether to relax the filter — do not guess here.</li>
+ *   <li>Name matching: the observed advertised name carries a 4-hex-digit
+ *       suffix equal to the last two MAC bytes ("oraimo Watch 6 Lite_CD86",
+ *       MAC EC:12:2F:5A:CD:86). The regex therefore accepts an optional
+ *       _HHHH suffix and otherwise matches only exact model codes, so
+ *       unrelated devices (incl. other oraimo models) cannot match.</li>
+ *   <li>MTU 508: this is a *request* only — {@code MoyoungDeviceSupport}
+ *       calls {@code requestMtu(getMtu()+3)} and derives all framing from the
+ *       *negotiated* MTU via {@code calcMaxWriteChunk(super.getMTU())}, so an
+ *       over-request self-corrects. 508 matches the current family convention
+ *       for MTU-capable V2 devices (e.g. ColmiP81Coordinator); the abstract
+ *       default of 20 would pin a V2 device to legacy framing.</li>
+ *   <li>Deliberately NOT done in v1: no 0xB0 bind/auth handshake (unverified on
+ *       this family; connect/read proven ungated), no DFU/OTA paths, no
+ *       watch-face upload, no alarm-slot or REM/stress capability claims
+ *       (family defaults apply: 3 alarm slots, no REM flag) until measured.</li>
+ * </ul>
+ */
+public class OraimoWatch6LiteCoordinator extends AbstractMoyoungDeviceCoordinator {
+    @Override
+    protected Pattern getSupportedDeviceName() {
+        return Pattern.compile("^(oraimo Watch 6 Lite(_[0-9A-F]{4})?|OSW-809(_(PK|frf|frm))?)$", Pattern.CASE_INSENSITIVE);
+    }
+
+    @Override
+    public int getDeviceNameResource() {
+        return R.string.devicetype_oraimo_watch_6_lite;
+    }
+
+    @Override
+    @DrawableRes
+    public int getDefaultIconResource() {
+        return R.drawable.ic_device_miwatch;
+    }
+
+    @Override
+    public String getManufacturer() {
+        return "oraimo";
+    }
+
+    @Override
+    public int getMtu() {
+        return 508; // request only; see class javadoc
+    }
+}
